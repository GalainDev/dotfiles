{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*credentials.json)",
      "Read(**/serviceAccountKey*.json)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledPlugins": {},
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": ["~/.runes"]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "codeload.github.com",
        "registry.npmjs.org",
        "npmjs.org"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "gh",
      "gcloud",
      "docker"
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); dir=$(echo \"$input\" | jq -r '.workspace.current_dir'); d=$(echo \"$dir\" | sed \"s|^$HOME|~|\"); b=$(git --no-optional-locks -C \"$dir\" branch --show-current 2>/dev/null); dirty=$(git --no-optional-locks -C \"$dir\" status --porcelain 2>/dev/null | head -1); out=$(printf '\\033[36m%s\\033[0m' \"$d\"); [ -n \"$b\" ] && out=\"$out $(printf '\\033[35m%s\\033[0m' \"$b\")\"; [ -n \"$dirty\" ] && out=\"$out$(printf '\\033[33m*\\033[0m')\"; m=$(echo \"$input\" | jq -r '.model.display_name'); ctx=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); out=\"$out $(printf '\\033[2m| %s' \"$m\")\"; [ -n \"$ctx\" ] && out=\"$out $(printf '%.0f%% ctx' \"$ctx\")\"; printf '%s\\033[0m\\n' \"$out\""
  }
}
